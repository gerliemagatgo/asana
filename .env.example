# Copy this file to .env for local testing, or set these as Environment
# Variables in your hosting platform's dashboard (Render, Railway, etc.).
# NEVER commit a real .env file or paste your real token into chat/code.

# Required. Generate at: https://app.asana.com/0/my-apps
# (My Settings > Apps > Manage Developer Apps > Personal Access Tokens)
ASANA_TOKEN=

# Required. The Asana project new tickets should be created in by default.
# Find it in the project's URL: app.asana.com/1/<workspace>/project/<THIS NUMBER>/list
ASANA_PROJECT_GID=1207508814915091

# Optional. A simple shared passcode so random visitors to your app's URL
# can't create Asana tasks. Leave blank to disable (not recommended once
# this is deployed to a public URL).
ACCESS_CODE=change-me

# Optional. Port the server listens on. Most hosts set this for you.
PORT=3000
